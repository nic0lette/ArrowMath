{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "arrow-cards": ["./arrow-cards/src/index.ts"],
      "arrow-cards/svelte": ["./arrow-cards/src/svelte/ArrowCard.svelte"]
    },
    "types": ["svelte", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}
