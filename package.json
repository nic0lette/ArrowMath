{
  "name": "arrow-math",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arrow Cards — a tactile place-value workbench for primary classrooms.",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "dev:test": "vite --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "motion": "^14.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
